# ============================================================
# Trader AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Lead Form API Endpoint
# The endpoint that receives lead form submissions (POST JSON).
# If left empty, forms will log submissions to the browser console.
TRADERAI_LEAD_API_ENDPOINT=

# Market Data Provider
# API key or endpoint for live/delayed market data.
TRADERAI_MARKET_DATA_API_KEY=
TRADERAI_MARKET_DATA_ENDPOINT=

# Analytics
# Google Analytics or equivalent measurement ID.
TRADERAI_GA_MEASUREMENT_ID=

# Email Service
# For sending notifications, lead alerts, etc.
TRADERAI_EMAIL_SERVICE_KEY=

# Base URL
# Used for canonical URLs and sitemap generation.
TRADERAI_BASE_URL=https://traderai.com
